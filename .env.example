# =====================================================================
#  Kopiraj ovaj fajl u .env.local i popuni vrednosti:
#      cp .env.example .env.local
#  .env.local je u .gitignore — nikad ne ide na GitHub.
#  Iste promenljive upiši i na Vercelu: Project → Settings → Environment Variables.
#
#  Obavezne su samo dve Supabase vrednosti; sve ostalo uključuje
#  pojedinačne funkcije (igre, anime, podsetnik) i može kasnije.
# =====================================================================


# --- Supabase (OBAVEZNO) ---------------------------------------------
# URL projekta i javni (publishable) ključ, oba na jednom mestu:
#   https://supabase.com/dashboard/project/_?showConnect=true   (dugme "Connect")
# ili: Project Settings → API Keys
#   https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Tajni ključ (počinje sa sb_secret_). Treba ga SAMO podsetniku u 22h.
# Ista stranica: Project Settings → API Keys → Secret keys → "Create new secret key"
#   https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_SECRET_KEY=


# --- Adresa sajta -------------------------------------------------------
# Ostavi prazno dok nemaš svoj domen: na Vercelu se adresa uzima automatski.
# Kad kupiš domen: NEXT_PUBLIC_SITE_URL=https://tvoj-domen.com
NEXT_PUBLIC_SITE_URL=


# --- Igre: RAWG (pretraga "assas" → Assassin's Creed) --------------------
# Besplatan ključ (do 20.000 zahteva mesečno, za lične projekte):
#   https://rawg.io/apidocs   → "Get API Key"
RAWG_API_KEY=


# --- Anime: MyAnimeList -----------------------------------------------
# Client ID: https://myanimelist.net/apiconfig → "Create ID"
#   App Type: web; App Redirect URL: tvoja adresa (npr. https://licni-blog.vercel.app)
# Tvoja MAL lista mora biti javna. Korisničko ime upisuješ u aplikaciji (Podešavanja).
MAL_CLIENT_ID=


# --- Podsetnik u 22h (push notifikacije) --------------------------------
# VAPID par ključeva napravi jednom komandom u ovom folderu:
#   npm run vapid
# Prvi red ide u NEXT_PUBLIC_VAPID_PUBLIC_KEY, drugi u VAPID_PRIVATE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt za push servise (tvoj email, sa "mailto:")
VAPID_SUBJECT=mailto:

# Tajna kojom Supabase cron "kuca" na /api/cron/podsetnik (bar 32 znaka).
# Napravi je npr. ovako:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ISTU vrednost upisuješ i u supabase/podsetnik.sql.
CRON_SECRET=
